# ─────────────────────────────────────────────────────────────────────────────
# Azure DevOps (required)
# ─────────────────────────────────────────────────────────────────────────────
# PAT needs: Work Items (Read & Write), Code (Read, Write & Manage)
AZURE_DEVOPS_PAT=your-pat-here
AZURE_DEVOPS_ORG=continia-software
AZURE_DEVOPS_PROJECT=your-project-name

# MCP only. `.mcp.json` references this as ${ADO_MCP_PAT_B64}. @azure-devops/mcp
# uses the value verbatim as the Basic credential, so it must be pre-encoded —
# base64 of "<you@continia.com>:<pat>" — and NOT the raw AZURE_DEVOPS_PAT above.
#   Linux/macOS: printf '%s:%s' "$USER_EMAIL" "$PAT" | base64 -w0
#   PowerShell:  [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("$email`:$pat"))
ADO_MCP_PAT_B64=

# Optional: full WIQL override. Leave unset to use the tag-derived default:
#   SELECT [System.Id] FROM workitems
#   WHERE [System.Tags] CONTAINS '<TRIGGER_TAG>' AND [System.State] <> 'Closed'
#   ORDER BY [System.ChangedDate] ASC
# AZURE_DEVOPS_WIQL_QUERY=

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic (required)
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5
# AGENT_MAX_TURNS=400

# ─────────────────────────────────────────────────────────────────────────────
# Trigger tags
# ─────────────────────────────────────────────────────────────────────────────
# A work item carrying TRIGGER_TAG starts the pipeline. When the agent needs
# clarification it swaps TRIGGER_TAG for WAITING_TAG; re-adding TRIGGER_TAG
# after you answer resumes the job.
# TRIGGER_TAG=create-new-comm
# WAITING_TAG=create-new-comm-waiting
# DONE_TAG=create-new-comm-done
# FAILED_TAG=create-new-comm-failed

# ─────────────────────────────────────────────────────────────────────────────
# Polling / job control
# ─────────────────────────────────────────────────────────────────────────────
# POLL_INTERVAL_MINUTES=5
# JOB_TIMEOUT_MINUTES=240
# MAX_CLARIFY_ROUNDS=3

# ─────────────────────────────────────────────────────────────────────────────
# Target repositories
# ─────────────────────────────────────────────────────────────────────────────
# Repo IDs are the GUIDs from Azure DevOps (Project settings > Repositories).
# Names are used to build clone URLs, so they must match the repo name exactly.
BANKING_REPO_NAME=Continia Banking
BANKING_REPO_ID=
# BANKING_DEFAULT_BRANCH=main

SETUP_FILES_REPO_NAME=Continia Banking Setup Files
SETUP_FILES_REPO_ID=
# SETUP_FILES_DEFAULT_BRANCH=main

# Optional: comma-separated ADO identity IDs added as PR reviewers
# PR_REVIEWER_IDS=

# ─────────────────────────────────────────────────────────────────────────────
# Continia CLI (BC environments, deploy, test)
# ─────────────────────────────────────────────────────────────────────────────
CONTINIA_API_TOKEN=your-demoportal-api-token
# CONTINIA_CLI_PATH=/usr/local/bin/continia
# CONTINIA_API_URL=
# Auto-download the AL compiler on first compile (cached in CONTINIA_ALC_CACHE)
# CONTINIA_AUTO_INSTALL_ALC=1
# CONTINIA_ALC_CACHE=/data/alc-cache

# ─────────────────────────────────────────────────────────────────────────────
# Paths (container defaults; all under the mounted /data volume)
# ─────────────────────────────────────────────────────────────────────────────
# REPO_CACHE_DIR=/data/repos
# WORKTREE_ROOT=/data/worktrees
# LOG_DIR=/data/logs
# STATE_DIR=/data/state
# SKILLS_SOURCE_DIR=/app/.claude

# ─────────────────────────────────────────────────────────────────────────────
# Behaviour
# ─────────────────────────────────────────────────────────────────────────────
# DRAFT_PR=true
# Set true to skip the env/deploy/test phase (useful for smoke-testing the harness)
# SKIP_BUILD_TEST=false
# BRANCH_PREFIX=Userstory/agent
